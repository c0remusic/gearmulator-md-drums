/* Editor below the front panel (see mdDefault.rml). Window 1100 × 1000 dp.
   Grid: 16 dp margins, 12 columns of 78 dp, 12 dp gutters. Blocks are placed in dp by the RML.
   Colours: anthracite chassis, cream text, orange only for active state. */

.mdFrontPanel
{
	position: relative;
	flex: 0 0 570dp;
	width: 1100dp;
	height: 570dp;
}

.mdEdFoldedBar
{
	position: relative;
	box-sizing: border-box;
	flex: 0 0 32dp;
	height: 32dp;
	background-color: #141516;
	border-bottom: 1dp #2e3034;
}

.mdEdRoot
{
	flex: 1 1 0dp;
	min-height: 0dp;
	width: 1100dp;
	display: flex;
	flex-direction: column;
	background-color: #1c1d1f;
	font-family: Roboto;
	color: #f4f1ea;
}

.mdEdHeader, .mdEdStrip
{
	position: relative;
	box-sizing: border-box;
	background-color: #141516;
	border-bottom: 1dp #2e3034;
}

.mdEdHeader { flex: 0 0 56dp; height: 56dp; }
.mdEdStrip { flex: 0 0 48dp; height: 48dp; }

.mdEdPage
{
	flex: 1 1 0dp;
	min-height: 0dp;
	display: flex;
	flex-direction: column;
}

/* the only scrolling area; its 8 dp scrollbar sits in the right margin */
.mdEdScroll
{
	flex: 1 1 0dp;
	min-height: 0dp;
	overflow-y: auto;
}

.mdEdScroll scrollbarvertical { width: 8dp; }
.mdEdScroll scrollbarvertical sliderbar { background-color: #3a3d42; border-radius: 4dp; }

/* RCSS has no default styles: a div is inline unless told otherwise */
.mdEdContent
{
	display: block;
	position: relative;
	width: 1092dp;
}

/* text */

.mdEdLogo { height: 24dp; line-height: 24dp; font-size: 15dp; font-weight: bold; }
.mdEdTitle { height: 24dp; line-height: 24dp; font-size: 13dp; font-weight: bold; color: #f4f1ea; }
.mdEdSub { font-size: 11dp; font-weight: normal; color: #8a8d93; }
.mdEdValue { height: 14dp; line-height: 14dp; font-size: 12dp; text-align: center; color: #f4f1ea; }
.mdEdName { height: 14dp; line-height: 14dp; font-size: 10dp; font-weight: bold; text-align: center; color: #8a8d93; }
.mdEdNote { font-size: 12dp; line-height: 16dp; color: #8a8d93; }

/* blocks */

.mdEdBlock, .mdEdMixStrip
{
	background-color: #232427;
	border: 1dp #2e3034;
	border-radius: 4dp;
}

.mdEdStripName { height: 16dp; line-height: 16dp; font-size: 12dp; font-weight: bold; text-align: center; }

/* buttons */

.mdEdCat, .mdEdTrackTab, .mdEdButton, .mdEdMute
{
	border-width: 0dp;
	box-shadow: none;
	decorator: none;
	text-align: center;
	font-weight: bold;
	color: #8a8d93;
	cursor: pointer;
}

.mdEdCat { top: 12dp; width: 78dp; height: 32dp; line-height: 32dp; font-size: 12dp; border-radius: 3dp; }
.mdEdCat:hover, .mdEdTrackTab:hover, .mdEdButton:hover, .mdEdMute:hover { color: #f4f1ea; }
.mdEdCat:checked { color: #f4f1ea; background-color: #26282b; }

.mdEdTrackTab { top: 8dp; width: 60dp; height: 40dp; line-height: 40dp; font-size: 12dp; border-radius: 3dp 3dp 0dp 0dp; }
.mdEdTrackTab:checked { color: #f4f1ea; background-color: #1c1d1f; }

.mdEdButton { height: 24dp; line-height: 22dp; font-size: 11dp; border: 1dp #3a3d42; border-radius: 2dp; }
.mdEdButton:checked { color: #141516; background-color: #ff6b1f; border-color: #ff6b1f; }

.mdEdMute { width: 48dp; height: 24dp; line-height: 22dp; font-size: 10dp; border: 1dp #3a3d42; border-radius: 2dp; }
.mdEdMute:checked { color: #141516; background-color: #ff6b1f; border-color: #ff6b1f; }
