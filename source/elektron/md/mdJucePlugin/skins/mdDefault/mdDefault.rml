	<body id="Root" class="elektronPanel elektronPanel--md" resizableheight="1" style="left: 0dp; top: 0dp; width: 1100dp; height: 606dp; display: flex; flex-direction: column;">
		<!-- ===== Top bar: name, the FACE AVANT / ÉDITEUR switch, kit/pattern screen, categories, options. ===== -->
		<div id="mdTopBar" class="mdEdTopBar">
			<div class="jucePos juceLabel mdEdLogo" style="left: 16dp; top: 6dp; width: 168dp;">GEARMULATOR MD</div>
			<button id="mdViewPanel" class="jucePos juceButton mdEdSwitch" isToggle="1" style="left: 196dp;">FACE AVANT</button>
			<button id="mdViewEditor" class="jucePos juceButton mdEdSwitch" isToggle="1" style="left: 286dp;">ÉDITEUR</button>
			<div id="mdEdScreen" class="jucePos mdEdScreen" style="left: 376dp; top: 4dp; width: 168dp;"><div id="mdEdScreenMain" class="mdEdScreenMain">KIT — · PATTERN —</div><div id="mdEdScreenName" class="mdEdScreenName"></div></div>
			<button id="mdEdCat2" class="jucePos juceButton mdEdCat" tabgroup="mdEdit" tabbutton="2" style="left: 556dp;">JOUER</button>
			<button id="mdEdCat0" class="jucePos juceButton mdEdCat" tabgroup="mdEdit" tabbutton="0" style="left: 646dp;">SON</button>
			<button id="mdEdCat1" class="jucePos juceButton mdEdCat" tabgroup="mdEdit" tabbutton="1" style="left: 736dp;">MIX</button>
			<button id="mdEdCat3" class="jucePos juceButton mdEdCat" tabgroup="mdEdit" tabbutton="3" style="left: 826dp;">BIBLIO</button>
			<button id="mdEdCat4" class="jucePos juceButton mdEdCat" tabgroup="mdEdit" tabbutton="4" style="left: 916dp;">SYSTÈME</button>
			<button id="mdEdOptions" class="jucePos juceButton mdEdSwitch" isToggle="0" style="left: 1006dp;">OPTIONS</button>
		</div>
		<!-- The front panel, unchanged, 1100 × 570 dp. ViewLayout (mdViewLayout.cpp) shows it or the editor, or both when the window is tall enough. -->
		<div id="mdFrontPanel" class="mdFrontPanel">
		<div class="jucePos elektronAluminumPanel mdChassis" style="left: 0dp; top: 0dp; width: 1100dp; height: 570dp;"/>

		<!-- Rear-connector legends printed along the hardware's upper faceplate. -->

		<div class="jucePos juceLabel mdPortLabel" style="left: 95dp; top: 3dp; width: 50dp; height: 13dp; line-height: 13dp;">PHONES</div>
		<div class="jucePos juceLabel mdPortLabel" style="left: 154dp; top: 3dp; width: 50dp; height: 13dp; line-height: 13dp;">A / LEFT</div>
