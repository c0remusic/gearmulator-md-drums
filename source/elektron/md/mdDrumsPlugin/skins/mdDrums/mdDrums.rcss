/* MD Drums v22 (Design/HANDOFF.md), written by hand. Window pixels in dp; every box, padding and text baseline on a
   multiple of 4 (mdDrumsSkinTest checks them against the mockup's boxes, Design/v22-boxes.txt).

   Colours (HANDOFF, "Colour"): chrome #1b1c1e, surface #26272a, display #151618, line #3a3c40, rule #55585e,
   tick #3c3e43, ink #f2f2f2, ink-dim #a7aaaf, ink-faint #8e9197, track #6e7177, accent #6fd1c4, on-accent #10201e,
   mute #ff7a5c. vknob and vglyph draw with the same values. */

body.mdd { background-color: #1b1c1e; color: #f2f2f2; font-family: Inter; font-size: 14dp; font-weight: 400; }
.mdd * { white-space: nowrap; }
/* Boxes are the HANDOFF's, borders and padding inside them */
.inset, .tab span, .play, .toggle, .screen { box-sizing: border-box; }

/* ---- The grid: 16 columns of 64, gutters and margins of 16. Column c starts at 16 + 80 (c - 1). ---- */
.a { position: absolute; }
.c1 { left: 16dp; } .c2 { left: 96dp; } .c3 { left: 176dp; } .c4 { left: 256dp; } .c5 { left: 336dp; }
.c6 { left: 416dp; } .c7 { left: 496dp; } .c8 { left: 576dp; } .c9 { left: 656dp; } .c10 { left: 736dp; }
.c11 { left: 816dp; } .c12 { left: 896dp; } .c13 { left: 976dp; } .c14 { left: 1056dp; } .c15 { left: 1136dp; }
.c16 { left: 1216dp; }
.w1 { width: 64dp; } .w2 { width: 144dp; } .w3 { width: 224dp; } .w4 { width: 304dp; } .w8 { width: 624dp; }
/* Containers that only place their children (and hold a data model): no box, so they never take a click */
.layer { position: absolute; left: 0dp; top: 0dp; width: 0dp; height: 0dp; }

/* ---- Text ---- */
.label { font-size: 12dp; font-weight: 500; color: #a7aaaf; line-height: 16dp; }
.code { font-weight: 600; letter-spacing: 1dp; }
.hint { font-size: 12dp; color: #8e9197; }
.meta { font-size: 14dp; color: #a7aaaf; }
.meta b { font-weight: 400; color: #f2f2f2; }
.meta .code { color: #f2f2f2; font-size: 12dp; margin-right: 8dp; }
.inset { padding-left: 16dp; }
.r24 { height: 24dp; line-height: 24dp; }

/* ---- Top bar: y 0-56, its rule at 55 ---- */
.rule { height: 1dp; background-color: #55585e; }
.rule.full { left: 0dp; width: 1296dp; }
/* The editing area starts at column 3's end (x 240), not the gutter's middle as in the mockup: 16 px between it and
   knob 1, as between knob 8 and the screens (the user, 2026-10-08) */
.rule.edit { left: 240dp; width: 1056dp; }
.bar { top: 0dp; height: 56dp; line-height: 56dp; }
.logo { font-size: 14dp; font-weight: 700; letter-spacing: 2dp; line-height: 54dp; }
.logo span { font-weight: 400; color: #a7aaaf; margin-left: 4dp; letter-spacing: 0dp; }
.tab { font-size: 14dp; font-weight: 500; color: #a7aaaf; text-align: left; cursor: pointer; }
.tab span { display: inline-block; height: 56dp; line-height: 58dp; border-bottom: 2dp transparent; }
.tab:hover, .tab:checked { color: #f2f2f2; }
/* The open tab's mark: 2 px of accent under its text only, over the bar's rule */
.tab:checked span { border-bottom-color: #6fd1c4; }
/* 14 px text on a 24 px row: a 22 px line puts its baseline on the 4 px step, as the mockup's 2-3 px of padding did */
.size { top: 16dp; height: 24dp; line-height: 22dp; font-size: 14dp; cursor: pointer; }
.size .label { color: #8e9197; margin-right: 8dp; }
.size:hover .label { color: #a7aaaf; }
.mainlabel { top: 16dp; height: 16dp; }
.meter { top: 32dp; height: 8dp; }
.meter .bar1, .meter .bar2 { position: absolute; left: 0dp; width: 64dp; height: 2dp; background-color: #6e7177; }
.meter .bar1 { top: 1dp; }
.meter .bar2 { top: 5dp; }
.meter .fill { position: absolute; left: 0dp; top: 0dp; width: 0dp; height: 2dp; background-color: #6fd1c4; }

/* ---- Track tab ---- */
.surface { left: 240dp; top: 176dp; width: 1056dp; height: 648dp; background-color: #26272a; }

/* Head band: y 56-176, its rule at 175 across the window */
.kit { left: 16dp; top: 84dp; width: 168dp; height: 24dp; line-height: 22dp; font-size: 14dp; overflow: hidden; cursor: pointer; }
.kit .label { color: #8e9197; margin-right: 8dp; }
.kit .num { font-size: 12dp; color: #a7aaaf; margin-right: 8dp; }
.kitsave { left: 192dp; top: 84dp; width: 40dp; height: 24dp; line-height: 22dp; text-align: right; color: #8e9197; }
/* Lit while the Kit played differs from its Slot */
.kitsave.on { color: #f2f2f2; font-weight: 600; cursor: pointer; }
.tracks { top: 124dp; }
.caption { top: 84dp; }
.step { top: 84dp; width: 24dp; height: 24dp; line-height: 22dp; text-align: center; color: #a7aaaf; cursor: pointer; }
.step:hover { color: #f2f2f2; }
.step.prev { left: 336dp; }
.step.next { left: 360dp; }
.machine { top: 108dp; height: 40dp; line-height: 40dp; font-size: 34dp; cursor: pointer; }
/* Relative: the glyph's canvas fills the glyph, not the nearest positioned box */
vglyph { display: inline-block; position: relative; }
vglyph.chevron { width: 12dp; height: 12dp; margin-left: 12dp; color: #a7aaaf; }
.machine:hover vglyph.chevron { color: #f2f2f2; }
vglyph.down { width: 8dp; height: 8dp; margin-left: 4dp; color: #a7aaaf; }
.family { top: 84dp; height: 24dp; line-height: 22dp; }
.output { top: 124dp; height: 24dp; line-height: 22dp; }
.velocitylabel { top: 84dp; height: 24dp; line-height: 24dp; }
.velocity { top: 112dp; height: 32dp; line-height: 32dp; font-size: 22dp; cursor: pointer; drag: drag; }
.velocitybar { top: 144dp; height: 4dp; background-color: #3a3c40; }
.velocitybar .fill { position: absolute; left: 0dp; top: 0dp; height: 4dp; background-color: #a7aaaf; }
.play { top: 84dp; width: 64dp; height: 64dp; border: 1dp #6e7177; cursor: pointer; }
.play:hover { border-color: #f2f2f2; }
.play:active { background-color: #26272a; }
.play vglyph { position: absolute; left: 22dp; top: 21dp; width: 18dp; height: 20dp; color: #f2f2f2; }

/* Track list: rows of 40 from y 176, columns 1-3; the shown row lit to the editing area */
.row { left: 0dp; width: 0dp; height: 0dp; }
.rowsel { left: 0dp; width: 240dp; height: 40dp; background-color: #26272a; }
.rowmark { left: 0dp; width: 4dp; height: 24dp; background-color: #6fd1c4; }
.tn { left: 16dp; top: 8dp; width: 24dp; height: 24dp; line-height: 24dp; font-size: 12dp; color: #a7aaaf; cursor: pointer; }
.tm { left: 48dp; top: 8dp; width: 84dp; height: 24dp; line-height: 22dp; font-size: 14dp; letter-spacing: 1dp; color: #a7aaaf; overflow: hidden; cursor: pointer; }
.tn:hover, .tm:hover, .tn.tsel, .tm.tsel { color: #f2f2f2; }
.scope { left: 136dp; top: 8dp; width: 32dp; height: 24dp; }
.toggle { top: 8dp; width: 24dp; height: 24dp; line-height: 22dp; border: 1dp #6e7177; text-align: center; font-size: 12dp; font-weight: 600; color: #a7aaaf; cursor: pointer; }
.toggle:hover { border-color: #a7aaaf; color: #f2f2f2; }
.toggle.mute { left: 176dp; }
.toggle.solo { left: 208dp; }
.toggle.mute:checked { background-color: #ff7a5c; border-color: #ff7a5c; color: #111111; }
.toggle.solo:checked, .toggle.out:checked { background-color: #f2f2f2; border-color: #f2f2f2; color: #111111; }

/* Bands: 216 px from y 176, 392 and 608; content 28 px from the rules: title (+28), groups (+60), knobs (+84), names
   (+156), values (+172). Knob k on column 3 + k. */
.band { left: 0dp; width: 0dp; height: 0dp; }
.btitle { top: 28dp; height: 24dp; line-height: 24dp; font-size: 22dp; font-weight: 600; letter-spacing: 1.5dp; }
.grp { top: 60dp; height: 16dp; line-height: 16dp; font-size: 12dp; font-weight: 600; display: flex; align-items: center; }
.grp .line { flex: 1; height: 1dp; margin-left: 8dp; background-color: #55585e; }
.grp.sym .line { margin-left: 0dp; }
vknob { top: 84dp; width: 64dp; height: 64dp; drag: drag; cursor: pointer; }
.kl { top: 156dp; height: 16dp; line-height: 16dp; text-align: center; font-size: 12dp; font-weight: 500; letter-spacing: 1dp; color: #a7aaaf; }
.kv { top: 172dp; height: 16dp; line-height: 14dp; text-align: center; font-size: 14dp; color: #8e9197; }
.kv.edited { color: #f2f2f2; }
.unused { opacity: 0.35; }

/* Screens: columns 12-16 to the window's edge, 400 x 216 each, 16 px of room inside */
.screen { left: 896dp; top: 0dp; width: 400dp; height: 216dp; background-color: #151618; border-left: 1dp #55585e; }
.stitle { left: 15dp; top: 16dp; width: 368dp; height: 24dp; line-height: 22dp; }
.stitle .right { position: absolute; right: 0dp; top: 0dp; }
/* Word controls on a screen's title: the row's full height, so that their hover fill is */
.word { display: inline-block; vertical-align: top; height: 24dp; line-height: 22dp; font-size: 14dp; color: #f2f2f2; padding: 0dp 4dp; cursor: pointer; }
.word:hover { background-color: #26272a; }
.lfol { left: 15dp; width: 48dp; height: 16dp; margin-top: 4dp; }
.chip { width: 44dp; height: 24dp; line-height: 24dp; text-align: center; font-size: 12dp; font-weight: 500; letter-spacing: 1dp; color: #a7aaaf; cursor: pointer; }
.chip:hover { color: #f2f2f2; background-color: #26272a; }
.chip:checked { background-color: #6fd1c4; color: #10201e; }
.ch0 { left: 67dp; } .ch1 { left: 115dp; } .ch2 { left: 163dp; } .ch3 { left: 211dp; } .ch4 { left: 259dp; } .ch5 { left: 307dp; }
.lr1 { top: 112dp; } .lr2 { top: 144dp; } .lr3 { top: 176dp; }

/* ---- Overlays: hidden until the view opens them (mdDrumsTrackView.cpp) ---- */
.overlay { display: none; }
.col { position: absolute; top: 0dp; width: 0dp; height: 0dp; }
.w5 { width: 384dp; }
/* A title row: a 22 px title, then 14 px words; and the actions at its right, 24 px apart */
/* 24 px lines here: the 22 px title sets the baseline, which a 22 px line would put 1 px over the step */
.bhead { height: 24dp; line-height: 24dp; font-size: 14dp; color: #8e9197; }
.bhead span { margin-right: 12dp; }
.bhead .big, .pvname .big { font-size: 22dp; font-weight: 600; color: #f2f2f2; }
.bact { width: 384dp; height: 24dp; line-height: 22dp; text-align: right; font-size: 14dp; color: #a7aaaf; }
.bact .act { margin-left: 24dp; cursor: pointer; }
.act:hover { color: #f2f2f2; }
.keep, .kact .load { color: #f2f2f2; font-weight: 600; }

/* Kits: 64 Slots in four columns of 16 rows of 40, the chosen one's panel on columns 13-16 */
#kits_title, #kits_actions { top: 124dp; }
.slotsel { left: 0dp; width: 248dp; height: 40dp; background-color: #26272a; }
.slot { width: 224dp; height: 24dp; line-height: 22dp; font-size: 14dp; color: #a7aaaf; cursor: pointer; }
.slot.empty { color: #8e9197; }
.slot .num, .kitm .num { display: inline-block; width: 24dp; margin-right: 8dp; font-size: 12dp; letter-spacing: 0dp; color: #8e9197; }
.slot:hover, .slot.on { color: #f2f2f2; }
.kitssep { left: 968dp; top: 176dp; width: 1dp; height: 648dp; background-color: #3a3c40; }
.kitcaption { top: 184dp; width: 304dp; height: 24dp; line-height: 24dp; }
.kitpname { top: 208dp; width: 304dp; height: 32dp; line-height: 32dp; font-size: 22dp; font-weight: 600; }
.kitpname.empty { color: #8e9197; }
/* Rename: the name typed in place, 16 characters at most */
.kitedit { display: none; color: #f2f2f2; background-color: #151618; cursor: text; }
.kittracks { top: 256dp; width: 304dp; }
.kitm { width: 144dp; height: 24dp; line-height: 22dp; font-size: 14dp; letter-spacing: 1dp; color: #a7aaaf; }
.kact { top: 496dp; width: 304dp; height: 24dp; line-height: 22dp; font-size: 14dp; color: #a7aaaf; }
.kact .act { margin-right: 24dp; cursor: pointer; }
/* A click that would lose something asks for a second one; Cancel next to it */
.kact .confirm { color: #ff7a5c; }
#kit_confirm, #kit_cancel { display: none; }
.kitnote { top: 528dp; width: 304dp; height: 16dp; line-height: 16dp; }

/* The machine browser, over the bands: families on columns 4-10, ROM on 12-16 over the preview */
#browser_title, #browser_actions { top: 208dp; }
.fam { top: 248dp; }
.fam .count { margin-left: 8dp; font-weight: 500; color: #8e9197; }
.kind { top: 264dp; height: 16dp; line-height: 16dp; font-size: 12dp; color: #a7aaaf; }
.mach { box-sizing: border-box; width: 64dp; height: 24dp; line-height: 22dp; font-size: 14dp; letter-spacing: 1dp; color: #a7aaaf; border-bottom: 2dp transparent; cursor: pointer; }
.mach:hover { color: #f2f2f2; }
.mach:checked { color: #f2f2f2; border-bottom-color: #f2f2f2; }
.fam.preview { top: 528dp; }
.pvname { top: 552dp; height: 24dp; line-height: 24dp; }
.pvname .big { margin-right: 8dp; }
.pvauto { top: 584dp; height: 16dp; line-height: 14dp; font-size: 14dp; color: #a7aaaf; cursor: pointer; }
.pvauto .box { display: inline-block; width: 16dp; height: 16dp; margin-right: 8dp; border: 1dp #6e7177; vertical-align: top; }

/* The LFO's target menu, over the LFO screen: 80 px of labels, then cells of 36 */
.lfomenu { left: -1dp; top: 0dp; width: 400dp; height: 216dp; background-color: #151618; }
.mhead { left: 16dp; top: 16dp; width: 368dp; height: 24dp; line-height: 22dp; }
.mhead .label { margin-right: 8dp; }
.mhead .right { position: absolute; right: 0dp; top: 0dp; }
.mlabel { left: 16dp; width: 80dp; height: 16dp; margin-top: 4dp; }
.mt { width: 36dp; height: 24dp; line-height: 24dp; text-align: center; font-size: 12dp; color: #a7aaaf; cursor: pointer; }
.mt:hover { color: #f2f2f2; background-color: #26272a; }
.mt:checked { background-color: #6fd1c4; color: #10201e; }
.mt.off { color: #6e7177; }
.m0 { left: 96dp; } .m1 { left: 132dp; } .m2 { left: 168dp; } .m3 { left: 204dp; } .m4 { left: 240dp; } .m5 { left: 276dp; }
.m6 { left: 312dp; } .m7 { left: 348dp; }
.mr0 { top: 48dp; } .mr1 { top: 72dp; } .mr2 { top: 104dp; } .mr3 { top: 128dp; } .mr4 { top: 152dp; }

/* ---- Mix tab: strip t on column t ---- */
.mixsurface, .mastersurface { left: 0dp; top: 56dp; width: 1296dp; height: 768dp; background-color: #26272a; }
.stripsel { top: 56dp; height: 768dp; background-color: #1b1c1e; }
.stripbar { top: 56dp; height: 4dp; background-color: #6fd1c4; }
.sep { top: 56dp; width: 1dp; height: 768dp; background-color: #3a3c40; }
.strip, .send { top: 0dp; width: 0dp; height: 0dp; }
.sn { height: 16dp; line-height: 16dp; text-align: center; font-size: 12dp; color: #a7aaaf; cursor: pointer; }
.sn:hover { color: #f2f2f2; }
.sn.on { color: #6fd1c4; }
.sm { height: 24dp; line-height: 22dp; text-align: center; font-size: 14dp; letter-spacing: 1dp; cursor: pointer; }
.strip .sn { top: 84dp; }
.strip .sm { top: 100dp; }
vknob.pan { top: 132dp; }
.panlabel { top: 196dp; text-align: center; }
.vu { top: 228dp; width: 4dp; height: 492dp; background-color: #151618; }
.vu .fill { position: absolute; left: 0dp; bottom: 0dp; width: 4dp; height: 0dp; background-color: #6fd1c4; }
vknob.fader { top: 228dp; width: 64dp; height: 492dp; }
.level { top: 728dp; height: 16dp; line-height: 14dp; text-align: center; font-size: 14dp; }
.strip .toggle { top: 752dp; }
.strip .toggle.mute { left: 4dp; }
.strip .toggle.solo { left: 36dp; }
.strip .toggle.out { left: 4dp; top: 784dp; width: 56dp; }

/* ---- Master tab: effects of 272 px (title +28, what it is +60, groups +116, knobs +140, names +212, values +228),
   then the sends ---- */
.fx { width: 0dp; height: 0dp; }
.fxrole { top: 60dp; height: 24dp; line-height: 22dp; }
.fxgrp { top: 116dp; }
vknob.fxk { top: 140dp; }
.fxn { top: 212dp; }
.fxv { top: 228dp; }
.k0 { left: 0dp; } .k1 { left: 80dp; } .k2 { left: 160dp; } .k3 { left: 240dp; } .k4 { left: 320dp; } .k5 { left: 400dp; }
.k6 { left: 480dp; } .k7 { left: 560dp; }
.sendstitle { top: 628dp; }
.sendsrole { top: 628dp; width: 1024dp; }
.send .sn { top: 676dp; }
.send .sm { top: 692dp; }
vknob.sk { top: 728dp; width: 28dp; height: 28dp; }
.del { left: 0dp; }
.rev { left: 36dp; }
.skn { top: 764dp; width: 28dp; height: 16dp; line-height: 16dp; text-align: center; font-size: 12dp; font-weight: 500; letter-spacing: 1dp; color: #a7aaaf; }
.skv { top: 780dp; width: 28dp; height: 16dp; line-height: 14dp; text-align: center; font-size: 14dp; color: #8e9197; }
.skv.edited { color: #f2f2f2; }

/* A struck Track's number, in the list, in Mix and among the sends: accent for 140 ms (MeterView) */
.tn.trig, .sn.trig { color: #6fd1c4; }

/* The Hit screen's graduation words: 12 px on a baseline 16 px over the screen's foot (mdDrumsHitView.cpp) */
.tick { top: 188dp; height: 16dp; line-height: 16dp; display: none; }

/* The Filter and EQ screen's words: the graduations' 4 px after their lines on the axis' baseline, "0 dB" 4 px over its
   line (y 107), placed by mdDrumsFilterView.cpp */
.ftick { top: 188dp; height: 16dp; line-height: 16dp; }
.zerodb { left: 19dp; top: 92dp; height: 16dp; line-height: 16dp; }

/* The LFO screen: the values its wave reaches, in the label column at the plot's top (baseline y 660) and foot (716);
   "LFOD 0: no modulation" on the plot's middle row (688); ASSIGN armed, its title and Cancel in accent */
.lfov { left: 15dp; height: 16dp; line-height: 16dp; display: none; }
.lfov.high { top: 40dp; }
.lfov.low { top: 96dp; }
.lfonone { left: 67dp; top: 68dp; height: 16dp; line-height: 16dp; display: none; }
.asking { display: none; }
.stitle .word.on { color: #6fd1c4; }
/* Over the plot, which the screen's canvas draws */
.lfomenu { z-index: 1; }

/* A name an LFO modulates: ink, underlined 2 px in accent 4 px under its baseline (the mockup's text-decoration) */
.kl.lfo span { color: #f2f2f2; border-bottom: 2dp #6fd1c4; padding-bottom: 1dp; }

/* Listen while choosing, ticked */
.pvauto.on .box { background-color: #f2f2f2; border-color: #f2f2f2; }
