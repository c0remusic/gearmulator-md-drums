		<!-- ===== Master tab: two rows of two effects of 272 px, then the Tracks' sends ===== -->
		<div id="page_master" class="layer" tabgroup="view" tabpage="2">
			<div id="master_surface" class="a mastersurface"/>
			<div id="rule_327" class="a rule full" style="top: 327dp;"/>
			<div id="rule_599" class="a rule full" style="top: 599dp;"/>
			<div class="a fx c1" style="top: 56dp;" data-model="part0">
				<div id="echo_title" class="a w8 btitle">RHYTHM ECHO</div>
				<div id="echo_role" class="a w8 meta fxrole">Delay, tracks send with DEL</div>
				<div id="echo_group1" class="a k0 w4 grp fxgrp"><span>Delay</span><div class="line"/></div>
				<div id="echo_group2" class="a k4 w2 grp fxgrp"><span>Filter</span><div class="line"/></div>
				<div id="echo_group3" class="a k6 w2 grp fxgrp"><span>Output</span><div class="line"/></div>
				<vknob id="k_echo_TIME" class="a k0 fxk" param="EchoTIME"/><div id="n_echo_TIME" class="a k0 w1 kl fxn">TIME</div><div id="v_echo_TIME" class="a k0 w1 kv fxv" data-class-edited="EchoTIME_value != EchoTIME_default">{{EchoTIME_value}}</div>
				<vknob id="k_echo_MOD" class="a k1 fxk" param="EchoMOD"/><div id="n_echo_MOD" class="a k1 w1 kl fxn">MOD</div><div id="v_echo_MOD" class="a k1 w1 kv fxv" data-class-edited="EchoMOD_value != EchoMOD_default">{{EchoMOD_value}}</div>
				<vknob id="k_echo_MFRQ" class="a k2 fxk" param="EchoMFRQ"/><div id="n_echo_MFRQ" class="a k2 w1 kl fxn">MFRQ</div><div id="v_echo_MFRQ" class="a k2 w1 kv fxv" data-class-edited="EchoMFRQ_value != EchoMFRQ_default">{{EchoMFRQ_value}}</div>
				<vknob id="k_echo_FB" class="a k3 fxk" param="EchoFB"/><div id="n_echo_FB" class="a k3 w1 kl fxn">FB</div><div id="v_echo_FB" class="a k3 w1 kv fxv" data-class-edited="EchoFB_value != EchoFB_default">{{EchoFB_value}}</div>
				<vknob id="k_echo_FLTF" class="a k4 fxk" param="EchoFLTF"/><div id="n_echo_FLTF" class="a k4 w1 kl fxn">FLTF</div><div id="v_echo_FLTF" class="a k4 w1 kv fxv" data-class-edited="EchoFLTF_value != EchoFLTF_default">{{EchoFLTF_value}}</div>
				<vknob id="k_echo_FLTW" class="a k5 fxk" param="EchoFLTW"/><div id="n_echo_FLTW" class="a k5 w1 kl fxn">FLTW</div><div id="v_echo_FLTW" class="a k5 w1 kv fxv" data-class-edited="EchoFLTW_value != EchoFLTW_default">{{EchoFLTW_value}}</div>
				<vknob id="k_echo_MONO" class="a k6 fxk" param="EchoMONO"/><div id="n_echo_MONO" class="a k6 w1 kl fxn">MONO</div><div id="v_echo_MONO" class="a k6 w1 kv fxv" data-class-edited="EchoMONO_value != EchoMONO_default">{{EchoMONO_value}}</div>
